# Copy to scripts/migrate-data/.env (git-ignored) and fill in. Never commit the real values.
# Supabase → Connect → "Direct connection" (or "Session pooler" if your network has no IPv6).
SUPABASE_DB_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# Only needed to download product pictures.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role or sb_secret_ key>"
