{
  // SpazaStock on Cloudflare Workers. Replaces vercel.json (hosting) and, step by step, the
  // Supabase Edge Functions. See docs/cloudflare-migration.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spazastock",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /admin, /login and any other client route fall back to index.html.
    "not_found_handling": "single-page-application",
    // The API, plus /assets/* so a stale hashed file 404s instead of becoming index.html.
    // Everything else is served straight from the asset layer without running the Worker.
    "run_worker_first": ["/api/*", "/assets/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      // Shared data: users, shops, membership, catalog, plans, notifications, administration.
      // Schema: migrations/d1 (generated by npm run data:schema). Replace database_id with the id
      // printed by `npx wrangler d1 create spazastock` before the first remote apply.
      "binding": "DB",
      "database_name": "spazastock",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/d1"
    }
  ],
  "vars": {
    // Set to the real project URL before the first deploy (it is public, like VITE_SUPABASE_URL).
    "SUPABASE_URL": "https://your-project-ref.supabase.co"
  }
  // Secrets (never in this file): wrangler secret put SUPABASE_ANON_KEY
  //                                wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  // Phase 2+ adds here: "triggers": { "crons": [...] }, "r2_buckets", "durable_objects", "send_email".
}
