# Supabase Configuration (Get these from your Supabase project dashboard: Settings > API)
# Use only the public anon key or a sb_publishable_ key here. Everything in VITE_* variables is
# shipped to the browser. Service-role and secret keys bypass RLS: keep them in Supabase secrets.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Application Settings
VITE_APP_NAME="SpazaStock"
VITE_DEFAULT_LOCALE="en"

# Cloudflare Workers hosting: send Smart Product Scan to the Worker instead of the Supabase
# Edge Function. Leave unset to keep using the Edge Function (e.g. on Vercel).
# VITE_PRODUCT_LOOKUP_URL="/api/product-lookup"
